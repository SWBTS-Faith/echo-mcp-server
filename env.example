# Environment variables for MCP Server Template
# Copy this file to .env and fill in your values

# API Keys (add as needed for your tools)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GROQ_API_KEY=your_groq_key_here

# Railway automatically sets PORT, but you can override locally
# PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Add any other environment variables your MCP tools need
